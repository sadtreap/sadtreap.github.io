---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav class="pagination row" aria-label="Pagination">
      <div class="main">
        {page.url.prev ? (
          <a href={page.url.prev} aria-label={t.a11y.goToPreviousPage}>
            ← {t.pagination.prev}
          </a>
        ) : (
          <span aria-disabled="true">← {t.pagination.prev}</span>
        )}
        <span class="count">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next ? (
          <a href={page.url.next} aria-label={t.a11y.goToNextPage}>
            {t.pagination.next} →
          </a>
        ) : (
          <span aria-disabled="true">{t.pagination.next} →</span>
        )}
      </div>
    </nav>
  )
}

<style>
  .pagination {
    padding-block: 1.5rem 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .main {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  a {
    color: var(--accent);
  }

  [aria-disabled] {
    color: var(--muted-foreground);
    opacity: 0.6;
  }

  .count {
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>
