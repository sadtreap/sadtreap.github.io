---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { formatDate, formatWeekday, getReadingMinutes } from "@/utils/postMeta";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  post: CollectionEntry<"posts">;
  /** Title only, for short lists under a post */
  compact?: boolean;
  /** Text above the date in the side column, e.g. "이전 글" */
  sideLabel?: string;
};

const { post, compact = false, sideLabel } = Astro.props;
const { id, filePath, data } = post;
const { title, description, tags, pubDatetime, timezone } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const href = getPostUrl(id, filePath, locale);
---

<article class:list={["post-item row", { compact }]}>
  <div class="main">
    <div class="topics">
      {
        tags.map(tag => (
          <a href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}>
            {tag}
          </a>
        ))
      }
    </div>
    <h3>
      <a href={href} transition:name={toTransitionName(id)}>{title}</a>
    </h3>
    {
      !compact && (
        <>
          <p>{description}</p>
          <a class="more" href={href} tabindex="-1" aria-hidden="true">
            {t.post.readMore} →
          </a>
        </>
      )
    }
  </div>
  <div class="side note">
    {sideLabel && <span class="label">{sideLabel}</span>}
    <time class="date" datetime={pubDatetime.toISOString()}>
      {formatDate(pubDatetime, timezone)}
    </time>
    <span>
      {formatWeekday(pubDatetime, timezone)} · {
        tplStr(t.post.readingTime, { minutes: getReadingMinutes(post) })
      }
    </span>
  </div>
</article>

<style>
  .post-item {
    align-items: start;
    padding-block: 2.25rem;
  }

  .post-item.compact {
    padding-block: 1.375rem;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .topics a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h3 {
    font-size: 1.4375rem;
    font-weight: 700;
    line-height: 1.42;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  .compact h3 {
    font-size: 1.25rem;
  }

  h3 a:hover {
    color: var(--accent);
  }

  p {
    max-width: 38em;
    margin-block: 0.625rem 0.875rem;
    color: var(--foreground-soft);
    font-size: 1.03125rem;
    line-height: 1.8;
  }

  .more {
    color: var(--accent);
    font-size: 0.90625rem;
    font-weight: 500;
  }

  .date {
    color: var(--foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .compact .label + .date {
    margin-top: 0.125rem;
  }

  @media (max-width: 820px) {
    .post-item,
    .post-item.compact {
      padding-block: 1.625rem;
    }

    .side {
      order: -1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.125rem 0.75rem;
    }

    h3 {
      font-size: 1.25rem;
    }

    p {
      font-size: 0.96875rem;
    }
  }
</style>
