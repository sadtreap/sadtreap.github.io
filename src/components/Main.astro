---
type Props = {
  pageTitle: string;
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;
---

<main id="main-content" class:list={["flex-1 pb-16", className]}>
  <header class="page-head row">
    <div class="main">
      <h1>{pageTitle}</h1>
      {pageDesc && <p>{pageDesc}</p>}
    </div>
    <div class="side note"><slot name="side" /></div>
  </header>
  <slot />
</main>

<style>
  .page-head {
    align-items: end;
    padding-block: 3.5rem 1.75rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.24;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  p {
    margin-top: 0.75rem;
    color: var(--foreground-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  @media (max-width: 820px) {
    .page-head {
      padding-block: 2rem 1rem;
    }

    h1 {
      font-size: 1.875rem;
    }
  }
</style>
