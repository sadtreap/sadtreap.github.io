---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

// Compare the first path segment without base, locale or trailing slash.
const section = stripLocale(stripBase(Astro.url.pathname), locale)
  .split("/")
  .filter(Boolean)[0];

const links = [
  { path: "posts", label: t.nav.posts, active: ["posts", "archives"] },
  { path: "tags", label: t.nav.tags, active: ["tags"] },
  { path: "about", label: t.nav.about, active: ["about"] },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="site-header row">
  <a href={getRelativeLocaleUrl(locale, "")} class="brand main">
    <span class="bg-accent size-2 rounded-full" aria-hidden="true"></span>
    {site.title}
  </a>
  <nav class="side site-nav" aria-label="Main">
    <ul id="menu-items" class="nav-links">
      {
        links.map(({ path, label, active }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, path)}
              aria-current={active.includes(section) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="nav-tools">
      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            title={t.nav.search}
            aria-label={t.nav.search}
            aria-current={section === "search" ? "page" : undefined}
          >
            <IconSearch />
          </a>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="dark:hidden" />
            <IconSunHigh class="hidden dark:block" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="menu-btn"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconMenuDeep class="menu-open" />
        <IconX class="menu-close" />
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    align-items: center;
    padding-block: 1.25rem 1.5rem;
  }

  .brand {
    display: inline-flex;
    gap: 0.625rem;
    align-items: center;
    justify-self: start;
    color: var(--accent);
    font-size: 1.0625rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .site-nav {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 1rem;
    font-size: 0.8125rem;
  }

  .nav-links a {
    color: var(--muted-foreground);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--foreground);
  }

  .nav-links a[aria-current] {
    font-weight: 600;
  }

  .nav-tools {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--muted-foreground);
  }

  .nav-tools a:hover,
  .nav-tools button:hover,
  .nav-tools [aria-current] {
    color: var(--foreground);
  }

  .nav-tools :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .menu-btn,
  .menu-btn :global(.menu-close) {
    display: none;
  }

  .menu-btn[aria-expanded="true"] :global(.menu-open) {
    display: none;
  }

  .menu-btn[aria-expanded="true"] :global(.menu-close) {
    display: block;
  }

  @media (max-width: 820px) {
    .site-header {
      display: flex;
      justify-content: space-between;
      padding-block: 1.125rem 0.875rem;
    }

    .menu-btn {
      display: block;
    }

    .nav-links {
      position: absolute;
      inset: 100% 0 auto;
      z-index: 20;
      display: none;
      flex-direction: column;
      gap: 0;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
      background: var(--background);
      font-size: 1rem;
    }

    .nav-links a {
      display: block;
      padding-block: 0.625rem;
    }

    .site-nav:has([aria-expanded="true"]) .nav-links {
      display: flex;
    }
  }
</style>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    if (!menuBtn) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const open = menuBtn.getAttribute("aria-expanded") !== "true";
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
