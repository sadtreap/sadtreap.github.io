---
type Props = {
  title: string;
  side?: string;
};

const { title, side } = Astro.props;
---

<div class="list-head row">
  <h2 class="main">{title}</h2>
  {side && <span class="side label">{side}</span>}
</div>

<style>
  .list-head {
    align-items: baseline;
    padding-top: 2.5rem;
  }

  h2 {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  @media (max-width: 820px) {
    .list-head {
      padding-top: 1.5rem;
    }

    .label {
      display: none;
    }
  }
</style>
