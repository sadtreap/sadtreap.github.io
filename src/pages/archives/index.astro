---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import ListHead from "@/components/ListHead.astro";
import PostItem from "@/components/PostItem.astro";
import Footer from "@/components/Footer.astro";
import { postFilter } from "@/utils/postFilter";
import { formatMonth } from "@/utils/postMeta";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = (await getCollection("posts"))
  .filter(postFilter)
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

// Group by month in the post's own timezone, newest first.
const months = Map.groupBy(posts, ({ data }) =>
  formatMonth(data.pubDatetime, data.timezone)
);
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />
  <Main pageTitle={t.pages.archivesTitle}>
    <span slot="side">{tplStr(t.pages.postCount, { count: posts.length })}</span
    >
    {
      [...months].map(([month, monthPosts]) => (
        <section>
          <ListHead
            title={month}
            side={tplStr(t.pages.postCount, { count: monthPosts.length })}
          />
          {monthPosts.map(post => (
            <PostItem {post} compact />
          ))}
        </section>
      ))
    }
  </Main>
  <Footer />
</Layout>
