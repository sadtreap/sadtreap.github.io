---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const pagefindBundlePath = getAssetPath("pagefind/");

const t = useTranslations(locale);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.searchTitle}>
    <div class="row">
      <div
        id="pagefind-search"
        class="main"
        transition:persist
        data-bundle-path={pagefindBundlePath}
      >
      </div>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  type SearchUI = { triggerSearch: (query: string) => void };
  const searchInstances = new WeakMap<HTMLElement, SearchUI>();
  const pendingSearches = new WeakSet<HTMLElement>();

  function syncSearchQuery(container: HTMLElement, search: SearchUI) {
    const query = new URLSearchParams(window.location.search).get("q") ?? "";
    const input = container.querySelector<HTMLInputElement>(
      ".pagefind-ui__search-input"
    );
    if (input?.value === query) return;

    if (query) {
      search.triggerSearch(query);
    } else {
      // Pagefind's triggerSearch ignores empty terms; use its clear control.
      container
        .querySelector<HTMLButtonElement>(".pagefind-ui__search-clear")
        ?.click();
    }
  }

  function updateSearchQuery(container: HTMLElement, query: string) {
    if (!container.isConnected) return;

    const url = new URL(window.location.href);
    if (query.trim()) {
      url.searchParams.set("q", query);
    } else {
      url.searchParams.delete("q");
    }
    if (url.href !== window.location.href) {
      history.replaceState(history.state, "", url);
    }
  }

  function initSearch() {
    const pageFindSearch =
      document.querySelector<HTMLElement>("#pagefind-search");
    if (!pageFindSearch || pendingSearches.has(pageFindSearch)) return;

    const existingSearch = searchInstances.get(pageFindSearch);
    if (existingSearch) {
      syncSearchQuery(pageFindSearch, existingSearch);
      return;
    }

    const bundlePath = pageFindSearch.dataset.bundlePath;
    if (!bundlePath) return;

    pendingSearches.add(pageFindSearch);
    pageFindSearch.setAttribute("aria-busy", "true");

    async function loadSearch() {
      try {
        if (!pageFindSearch?.isConnected) return;
        // @ts-expect-error — Missing types for @pagefind/default-ui package.
        const { PagefindUI } = await import("@pagefind/default-ui");
        if (!pageFindSearch.isConnected) return;

        if (import.meta.env.DEV) {
          pageFindSearch.innerHTML = `
            <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
              <p><strong>DEV mode Warning! </strong>You need to build the project at least once to see the search results during development.</p>
              <code class="block bg-black text-white px-2 py-1 rounded">pnpm run build</code>
            </div>
          `;
        }

        const search: SearchUI = new PagefindUI({
          element: pageFindSearch,
          bundlePath,
          showImages: false,
          showSubResults: true,
        });
        searchInstances.set(pageFindSearch, search);

        // Delegate to the stable container so replacing controls keeps their handlers.
        pageFindSearch.addEventListener("input", event => {
          if (
            event.target instanceof HTMLInputElement &&
            event.target.matches(".pagefind-ui__search-input")
          ) {
            updateSearchQuery(pageFindSearch, event.target.value);
          }
        });
        pageFindSearch.addEventListener("click", event => {
          if (
            event.target instanceof Element &&
            event.target.closest(".pagefind-ui__search-clear")
          ) {
            updateSearchQuery(pageFindSearch, "");
          }
        });
        pageFindSearch.addEventListener("keydown", event => {
          if (
            event.key === "Escape" &&
            event.target instanceof HTMLInputElement &&
            event.target.matches(".pagefind-ui__search-input")
          ) {
            updateSearchQuery(pageFindSearch, "");
          }
        });

        // Read the current URL after loading, including persisted navigation.
        syncSearchQuery(pageFindSearch, search);
      } catch {
        if (!pageFindSearch?.isConnected) return;
        const message = document.createElement("p");
        message.setAttribute("role", "alert");
        message.textContent = document.documentElement.lang.startsWith("ko")
          ? "검색을 불러오지 못했습니다. 페이지를 새로고침해 주세요."
          : "Search could not be loaded. Please refresh the page.";
        pageFindSearch.replaceChildren(message);
      } finally {
        if (pageFindSearch) {
          pendingSearches.delete(pageFindSearch);
          pageFindSearch.removeAttribute("aria-busy");
        }
      }
    }

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(() => void loadSearch(), { timeout: 1000 });
    } else {
      setTimeout(() => void loadSearch(), 0);
    }
  }

  document.addEventListener("astro:after-swap", initSearch);
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
    }

    input:focus-visible {
      outline: 1px solid var(--accent);
    }

    .pagefind-ui__result-title a {
      color: var(--foreground);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:hover {
      color: var(--accent);
    }

    .pagefind-ui__result-excerpt {
      color: var(--foreground-soft);
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
