---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostsByTag } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const posts = getSortedPosts(await getCollection("posts"));
const tags = getPostsByTag(posts).map(({ tag, tagName, posts: tagPosts }) => ({
  tag,
  tagName,
  count: tagPosts.length,
}));

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />
  <Main pageTitle={t.pages.tagsTitle}>
    <ul>
      {
        tags.map(({ tag, tagName, count }) => (
          <li class="tag-row row">
            <a
              class="main"
              href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
              transition:name={tag}
            >
              {tagName}
            </a>
            <span class="side note">
              {tplStr(t.pages.postCount, { count })}
            </span>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>

<style>
  .tag-row {
    align-items: baseline;
    padding-block: 0.875rem;
    border-top: 1px solid var(--border);
  }

  .tag-row a {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .tag-row a:hover {
    color: var(--accent);
  }
</style>
