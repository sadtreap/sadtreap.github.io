---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ListHead from "@/components/ListHead.astro";
import PostItem from "@/components/PostItem.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { formatDate, getReadingMinutes } from "@/utils/postMeta";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("posts"));

  // posts is newest-first, so the older post has the higher index.
  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      olderPost: posts[index + 1] ?? null,
      newerPost: posts[index - 1] ?? null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  olderPost: CollectionEntry<"posts"> | null;
  newerPost: CollectionEntry<"posts"> | null;
};

const { post, olderPost, newerPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  author,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
} = post.data;

const { Content, headings } = await render(post);
const contents = headings.filter(
  ({ depth, slug }) => depth === 2 && slug !== "footnote-label"
);

const ogImageUrl =
  typeof initOgImage === "string" ? initOgImage : initOgImage?.src;
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const isModified = modDatetime && modDatetime > pubDatetime;
const postUrl = new URL(getPostUrl(post.id, post.filePath, locale), Astro.site);
const citationDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: timezone ?? config.site.timezone,
}).format(pubDatetime);
const authorFamilyName = author.split(" ").at(-1);
const authorInitial = author.charAt(0);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content" class="flex-1">
    <header class="post-head row">
      <div class="main">
        <p class="topics label">{tags.join(" · ")}</p>
        <h1 style={{ viewTransitionName: toTransitionName(post.id) }}>
          {title}
        </h1>
        <p class="deck">{description}</p>
      </div>
      {
        contents.length > 0 && (
          <nav class="side note toc" aria-labelledby="contents-label">
            <span id="contents-label" class="label">
              {t.post.contents}
            </span>
            <ol>
              {contents.map(({ slug, text }, index) => (
                <li>
                  <span aria-hidden="true">{index + 1}</span>
                  <a href={`#${slug}`}>{text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </header>

    <dl class="byline row">
      <div class="full">
        <div>
          <dt class="label">{t.post.author}</dt>
          <dd>
            {
              config.site.profile ? (
                <a class="text-accent" href={config.site.profile}>
                  {author}
                </a>
              ) : (
                author
              )
            }
          </dd>
        </div>
        <div>
          <dt class="label">
            {isModified ? t.post.updated : t.post.published}
          </dt>
          <dd>
            <time
              datetime={(isModified ? modDatetime : pubDatetime).toISOString()}
            >
              {formatDate(isModified ? modDatetime : pubDatetime, timezone)}
            </time>
          </dd>
        </div>
        <div>
          <dt class="label">{t.post.topics}</dt>
          <dd class="tags">
            {
              tags.map(tag => (
                <a
                  href={getRelativeLocaleUrl(
                    locale,
                    `tags/${slugifyStr(tag)}/`
                  )}
                >
                  {tag}
                </a>
              ))
            }
          </dd>
        </div>
        <div>
          <dt class="label">{t.post.reading}</dt>
          <dd>
            {tplStr(t.post.minutes, { minutes: getReadingMinutes(post) })}
          </dd>
        </div>
      </div>
    </dl>

    <div class="row">
      <article id="article" class="main app-prose" data-pagefind-body>
        <Content />
      </article>
    </div>

    <section class="appendix" aria-label="Appendix">
      <div class="row band">
        <p class="main">{t.post.reuseText}</p>
        <span class="side label">{t.post.reuse}</span>
      </div>
      <div class="row band">
        <p class="main">
          {authorFamilyName}, {authorInitial}. ({citationDate}). {title}. <i
            >{config.site.title}</i
          >. <a href={postUrl.href}>{decodeURI(postUrl.href)}</a>
        </p>
        <span class="side label">{t.post.citation}</span>
      </div>
    </section>

    {
      (newerPost || olderPost) && (
        <section class="pt-10 pb-16" data-pagefind-ignore>
          <ListHead title={t.post.morePosts} />
          {newerPost && (
            <PostItem post={newerPost} compact sideLabel={t.post.nextPost} />
          )}
          {olderPost && (
            <PostItem
              post={olderPost}
              compact
              sideLabel={t.post.previousPost}
            />
          )}
        </section>
      )
    }
  </main>

  <Footer />
</PostLayout>

<style>
  .post-head {
    align-items: start;
    padding-block: 3.5rem 2rem;
  }

  .topics {
    color: var(--accent);
  }

  h1 {
    margin-block: 0.75rem 1rem;
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.24;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .deck {
    max-width: 34em;
    color: var(--foreground-soft);
    font-size: 1.25rem;
    line-height: 1.65;
    letter-spacing: -0.015em;
  }

  .toc {
    padding-top: 0.375rem;
  }

  .toc ol {
    display: grid;
    gap: 0.3125rem;
    margin-top: 0.5rem;
  }

  .toc li {
    display: grid;
    grid-template-columns: 1.375rem minmax(0, 1fr);
    font-size: 0.84375rem;
  }

  .toc li span {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    line-height: 1.9;
  }

  .toc a {
    color: var(--foreground-soft);
  }

  .toc a:hover {
    color: var(--accent);
  }

  .byline {
    margin-bottom: 2.75rem;
    padding-block: 0.875rem 1rem;
    border-block: 1px solid var(--border);
    border-top-color: var(--foreground);
  }

  .byline .full {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .byline dd {
    margin-top: 0.1875rem;
    font-size: 0.90625rem;
  }

  .byline .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }

  .byline .tags a:hover {
    color: var(--accent);
  }

  /* The footnote list (if any) ends the article as the first band row. */
  .appendix {
    margin-top: 4.5rem;
  }

  .row:has(:global(.footnotes)) + .appendix {
    margin-top: 0;
  }

  .appendix .row {
    align-items: baseline;
    padding-block: 1.375rem;
    border-top: 1px solid var(--border);
    color: var(--foreground-soft);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .appendix i {
    color: var(--foreground);
    font-style: normal;
  }

  .appendix a {
    word-break: break-all;
  }

  .appendix a:hover {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .post-head {
      padding-block: 2rem 1.25rem;
    }

    h1 {
      font-size: 1.875rem;
    }

    .deck {
      font-size: 1.09375rem;
    }

    .toc {
      display: none;
    }

    .byline .full {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .appendix .side {
      order: -1;
    }
  }
</style>

<script>
  import "@/scripts/article";
</script>
