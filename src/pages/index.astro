---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ListHead from "@/components/ListHead.astro";
import PostItem from "@/components/PostItem.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { formatYearMonth } from "@/utils/postMeta";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

const posts = getSortedPosts(await getCollection("posts"));
const recentPosts = posts.slice(0, config.posts.perIndex);
const firstPublished = posts
  .map(({ data }) => data.pubDatetime)
  .sort((a, b) => a.getTime() - b.getTime())[0];
---

<Layout>
  <Header />
  <main id="main-content" class="flex-1 pb-16">
    <section class="hero row">
      <div class="main">
        <h1>{site.title}</h1>
        <p>{site.description}</p>
      </div>
      <aside class="side note">
        <b>{site.author}</b>
        {site.focus && <span>{site.focus}</span>}
        {
          firstPublished && (
            <span>
              since {formatYearMonth(firstPublished)} · {posts.length}{" "}
              {posts.length === 1 ? "post" : "posts"}
            </span>
          )
        }
      </aside>
    </section>

    <ListHead title={t.home.recentPosts} side={t.home.dateAndReading} />
    {recentPosts.map(post => <PostItem {post} />)}
    {
      posts.length > recentPosts.length && (
        <div class="row">
          <a
            class="main text-accent text-sm font-medium"
            href={getRelativeLocaleUrl(locale, "posts")}
          >
            {t.home.allPosts} →
          </a>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    align-items: end;
    padding-block: 4rem 4.5rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin-bottom: 1.625rem;
    color: color-mix(in srgb, var(--foreground) 78%, var(--background));
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  p {
    max-width: 31em;
    color: var(--foreground-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  aside {
    margin-bottom: 0.75rem;
  }

  aside b {
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 650;
  }

  @media (max-width: 820px) {
    .hero {
      padding-block: 2.25rem 2.5rem;
    }

    h1 {
      font-size: 2.25rem;
    }

    aside {
      margin: 1.25rem 0 0;
      padding-left: 0.75rem;
      border-left: 2px solid var(--margin-rule);
    }
  }
</style>
