---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ListHead from "@/components/ListHead.astro";
import PostItem from "@/components/PostItem.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = getSortedPosts(await getCollection("posts"));
const recentPosts = posts.slice(0, config.posts.perIndex);
---

<Layout>
  <Header />
  <main id="main-content" class="flex-1 pb-16">
    <h1 class="sr-only">{config.site.title}</h1>
    <ListHead title={t.home.recentPosts} side={t.home.dateAndReading} />
    {recentPosts.map(post => <PostItem {post} />)}
    {
      posts.length > recentPosts.length && (
        <div class="row">
          <a
            class="main text-accent text-sm font-medium"
            href={getRelativeLocaleUrl(locale, "posts")}
          >
            {t.home.allPosts} →
          </a>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
