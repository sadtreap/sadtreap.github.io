---
import Layout from "./Layout.astro";
import config from "@/config";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";

type Props = {
  title: string;
  headline: string;
  author: string;
  tags: string[];
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  author,
  tags,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
} = Astro.props;
const siteURL = new URL(site.url).href;
const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url).href;
const authorData = {
  "@type": "Person",
  name: author,
  ...(author === site.author && {
    "@id": `${siteURL}#author`,
    ...(site.profile && { url: site.profile }),
  }),
};
const dateModified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalURL}#article`,
  url: canonicalURL,
  mainEntityOfPage: { "@id": `${canonicalURL}#webpage` },
  isPartOf: { "@id": `${siteURL}#website` },
  headline,
  description,
  image: [socialImageURL],
  inLanguage: Astro.currentLocale ?? site.lang,
  keywords: tags,
  license: "https://creativecommons.org/licenses/by/4.0/",
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(dateModified && { dateModified: dateModified.toISOString() }),
  author: [authorData],
  publisher: { "@id": `${siteURL}#author` },
};
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {author}
  ogType="article"
>
  <Fragment slot="head">
    {
      author === site.author && site.profile && (
        <meta property="article:author" content={site.profile} />
      )
    }
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </Fragment>

  <slot />
</Layout>
